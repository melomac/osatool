"\"reserved_words\""
"\"parameters\""
"\"direct\""
"\"has_direct_parameter\""
"\"group\""
"\"type\""
"\"source\""
"\"system\""
"true"
"0x"
"\\u"

# A zlib stream starts with these two bytes.
"\x78\x9c"
"\x78\x01"
"\x78\xda"

