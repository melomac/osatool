script one
    on value()
        return 1
    end value
end script

script two
    on value()
        return 2
    end value
end script

script three
    on value()
        return 3
    end value
end script

script four
    on value()
        return 4
    end value
end script

script five
    on value()
        return 5
    end value
end script

script six
    on value()
        return 6
    end value
end script

return (one's value()) + (two's value()) + (three's value()) + (four's value()) + (five's value()) + (six's value())
